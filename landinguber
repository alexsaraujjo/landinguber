<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>UniEntrega | Calculadora de Frete</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="container nav">

            <div class="logo">
                🛵 Uni<span>Entrega</span>
            </div>

            <nav>
                <a href="#inicio">Início</a>
                <a href="#calcular">Calcular frete</a>
                <a href="#como-funciona">Como funciona</a>
            </nav>

            <button id="darkMode" class="theme-button">
                🌙
            </button>

        </div>

    </header>


    <!-- HERO -->

    <section class="hero" id="inicio">

        <div class="container hero-content">

            <div class="hero-text">

                <span class="tag">
                    🛵 ENTREGA RÁPIDA
                </span>

                <h1>
                    Calcule o frete da
                    <span>UNINASSAU</span>
                    até você.
                </h1>

                <p>
                    Informe seu CEP e descubra o endereço,
                    a distância estimada e o valor aproximado
                    do frete por moto.
                </p>

                <a href="#calcular" class="btn primary">
                    Calcular meu frete
                </a>

            </div>


            <div class="hero-card">

                <div class="motorcycle">
                    🛵
                </div>

                <h3>
                    Entrega por Moto
                </h3>

                <p>
                    Uma estimativa rápida baseada na
                    distância entre a UNINASSAU e o destino.
                </p>

                <div class="hero-info">

                    <div>
                        <strong>📍</strong>
                        Fortaleza
                    </div>

                    <div>
                        <strong>⚡</strong>
                        Rápido
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CALCULADORA -->

    <section class="calculator-section" id="calcular">

        <div class="container">

            <div class="section-title">

                <span>CALCULADORA</span>

                <h2>
                    Calcule seu frete
                </h2>

                <p>
                    Digite seu CEP para consultar seu endereço
                    e estimar o valor da entrega.
                </p>

            </div>


            <div class="calculator">

                <div class="form">

                    <label for="cep">
                        CEP de destino
                    </label>

                    <div class="cep-input">

                        <input
                            type="text"
                            id="cep"
                            maxlength="9"
                            placeholder="Ex.: 60000-000"
                        >

                        <button
                            id="consultar"
                            class="btn primary">

                            Consultar

                        </button>

                    </div>

                    <small>
                        Digite apenas o CEP do local de entrega.
                    </small>


                    <!-- ENDEREÇO -->

                    <div
                        id="endereco"
                        class="address"
                        style="display: none;">

                        <h3>
                            📍 Endereço encontrado
                        </h3>

                        <p id="logradouro"></p>

                        <p id="bairro"></p>

                        <p id="cidade"></p>

                    </div>

                </div>


                <!-- RESULTADO -->

                <div
                    id="resultado"
                    class="result"
                    style="display: none;">

                    <h3>
                        Resultado da estimativa
                    </h3>


                    <div class="result-item">

                        <span>
                            🏫 Origem
                        </span>

                        <strong>
                            UNINASSAU Aguanambi
                        </strong>

                    </div>


                    <div class="result-item">

                        <span>
                            📍 Destino
                        </span>

                        <strong id="destino">
                            -
                        </strong>

                    </div>


                    <div class="result-item">

                        <span>
                            📏 Distância estimada
                        </span>

                        <strong id="distancia">
                            -
                        </strong>

                    </div>


                    <div class="result-item">

                        <span>
                            🛵 Uber Moto estimado
                        </span>

                        <strong id="uber">
                            -
                        </strong>

                    </div>


                    <div class="result-item">

                        <span>
                            📦 Taxa operacional
                        </span>

                        <strong>
                            R$ 2,00
                        </strong>

                    </div>


                    <div class="total">

                        <span>
                            Frete estimado
                        </span>

                        <strong id="frete">
                            R$ 0,00
                        </strong>

                    </div>


                    <a
                        id="rota"
                        href="#"
                        target="_blank"
                        class="maps-button">

                        🗺️ Ver rota no Google Maps

                    </a>


                    <p class="disclaimer">

                        * Valor meramente estimativo.
                        O preço real do Uber pode variar conforme
                        trânsito, demanda, horário e outros fatores.

                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- COMO FUNCIONA -->

    <section
        class="how"
        id="como-funciona">

        <div class="container">

            <div class="section-title">

                <span>
                    COMO FUNCIONA
                </span>

                <h2>
                    Simples e rápido
                </h2>

            </div>


            <div class="steps">


                <div class="step">

                    <div class="step-number">
                        1
                    </div>

                    <h3>
                        Digite seu CEP
                    </h3>

                    <p>
                        Informe o CEP do endereço onde
                        deseja receber a entrega.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">
                        2
                    </div>

                    <h3>
                        Consulte o endereço
                    </h3>

                    <p>
                        O sistema consulta automaticamente
                        o ViaCEP e encontra seu endereço.
                    </p>

                </div>


                <div class="step">

                    <div class="step-number">
                        3
                    </div>

                    <h3>
                        Veja o valor
                    </h3>

                    <p>
                        O sistema estima a distância e
                        calcula o valor aproximado do frete.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- FOOTER -->

    <footer>

        <div class="container footer-content">

            <div class="logo">
                🛵 Uni<span>Entrega</span>
            </div>

            <p>
                Calculadora de frete acadêmica.
            </p>

            <small>
                Projeto desenvolvido para fins educacionais.
            </small>

        </div>

    </footer>


    <script src="script.js"></script>

</body>

</html>

/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;

    background: #f8fafc;

    color: #172033;

    transition: 0.3s;
}

.container {
    width: 90%;

    max-width: 1150px;

    margin: auto;
}

a {
    text-decoration: none;
}


/* =========================
   HEADER
========================= */

header {
    background: white;

    border-bottom: 1px solid #e5e7eb;

    position: sticky;

    top: 0;

    z-index: 100;
}

.nav {
    height: 75px;

    display: flex;

    align-items: center;

    justify-content: space-between;
}

.logo {
    font-size: 24px;

    font-weight: 900;
}

.logo span {
    color: #16a34a;
}

nav {
    display: flex;

    gap: 30px;
}

nav a {
    color: #475569;

    font-weight: 600;

    transition: 0.2s;
}

nav a:hover {
    color: #16a34a;
}

.theme-button {
    width: 42px;

    height: 42px;

    border-radius: 50%;

    border: 1px solid #ddd;

    background: white;

    cursor: pointer;

    font-size: 18px;
}


/* =========================
   HERO
========================= */

.hero {
    padding: 90px 0;

    background:
        linear-gradient(
            135deg,
            #f0fdf4,
            #ffffff
        );
}

.hero-content {
    display: grid;

    grid-template-columns: 1.2fr 0.8fr;

    align-items: center;

    gap: 70px;
}

.tag {
    display: inline-block;

    padding: 8px 15px;

    border-radius: 30px;

    background: #dcfce7;

    color: #15803d;

    font-size: 13px;

    font-weight: bold;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: 54px;

    line-height: 1.1;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #16a34a;
}

.hero-text p {
    color: #64748b;

    font-size: 18px;

    line-height: 1.7;

    max-width: 600px;

    margin-bottom: 30px;
}


/* =========================
   BUTTON
========================= */

.btn {
    display: inline-block;

    padding: 14px 22px;

    border: none;

    border-radius: 9px;

    font-weight: bold;

    cursor: pointer;
}

.primary {
    background: #16a34a;

    color: white;
}

.primary:hover {
    background: #15803d;
}


/* =========================
   HERO CARD
========================= */

.hero-card {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 20px;

    padding: 40px;

    box-shadow:
        0 20px 50px
        rgba(22, 163, 74, 0.12);
}

.motorcycle {
    font-size: 100px;

    text-align: center;

    margin-bottom: 20px;
}

.hero-card h3 {
    font-size: 25px;

    margin-bottom: 10px;
}

.hero-card p {
    color: #64748b;

    line-height: 1.6;
}

.hero-info {
    display: flex;

    gap: 20px;

    margin-top: 25px;

    padding-top: 20px;

    border-top: 1px solid #e5e7eb;
}

.hero-info div {
    color: #64748b;

    font-size: 14px;
}


/* =========================
   SEÇÕES
========================= */

.calculator-section,
.how {
    padding: 90px 0;
}

.section-title {
    text-align: center;

    margin-bottom: 45px;
}

.section-title span {
    color: #16a34a;

    font-size: 13px;

    font-weight: bold;

    letter-spacing: 1px;
}

.section-title h2 {
    font-size: 38px;

    margin: 10px 0;
}

.section-title p {
    color: #64748b;

    line-height: 1.6;
}


/* =========================
   CALCULADORA
========================= */

.calculator {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;

    max-width: 950px;

    margin: auto;
}

.form,
.result {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 18px;

    padding: 30px;
}

.form label {
    display: block;

    font-weight: bold;

    margin-bottom: 10px;
}

.cep-input {
    display: flex;

    gap: 10px;
}

.cep-input input {
    flex: 1;

    padding: 14px;

    border: 1px solid #cbd5e1;

    border-radius: 8px;

    outline: none;

    font-size: 16px;
}

.cep-input input:focus {
    border-color: #16a34a;
}

.form small {
    display: block;

    color: #94a3b8;

    margin-top: 8px;
}


/* =========================
   ENDEREÇO
========================= */

.address {
    margin-top: 25px;

    padding: 20px;

    background: #f0fdf4;

    border-radius: 12px;

    border-left: 4px solid #16a34a;
}

.address h3 {
    margin-bottom: 12px;
}

.address p {
    color: #475569;

    margin-top: 5px;
}


/* =========================
   RESULTADO
========================= */

.result h3 {
    margin-bottom: 20px;
}

.result-item {
    display: flex;

    justify-content: space-between;

    gap: 20px;

    padding: 14px 0;

    border-bottom: 1px solid #e5e7eb;
}

.result-item span {
    color: #64748b;
}

.result-item strong {
    text-align: right;
}

.total {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-top: 20px;

    padding: 20px;

    border-radius: 12px;

    background: #dcfce7;
}

.total span {
    font-weight: bold;
}

.total strong {
    font-size: 26px;

    color: #15803d;
}

.maps-button {
    display: block;

    text-align: center;

    padding: 13px;

    margin-top: 20px;

    background: #172033;

    color: white;

    border-radius: 8px;

    font-weight: bold;
}

.disclaimer {
    margin-top: 18px;

    font-size: 11px;

    line-height: 1.5;

    color: #94a3b8;
}


/* =========================
   COMO FUNCIONA
========================= */

.how {
    background: white;
}

.steps {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.step {
    text-align: center;

    padding: 30px;
}

.step-number {
    width: 50px;

    height: 50px;

    margin: 0 auto 20px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #16a34a;

    color: white;

    font-weight: bold;

    font-size: 20px;
}

.step h3 {
    margin-bottom: 10px;
}

.step p {
    color: #64748b;

    line-height: 1.6;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #172033;

    color: white;

    padding: 45px 0;
}

.footer-content {
    text-align: center;
}

.footer-content p {
    color: #94a3b8;

    margin: 10px 0;
}

.footer-content small {
    color: #64748b;
}


/* =========================
   DARK MODE
========================= */

body.dark {
    background: #0f172a;

    color: #f8fafc;
}

body.dark header {
    background: #0f172a;

    border-color: #1e293b;
}

body.dark nav a {
    color: #cbd5e1;
}

body.dark .theme-button {
    background: #1e293b;

    border-color: #334155;
}

body.dark .hero {
    background:
        linear-gradient(
            135deg,
            #052e16,
            #0f172a
        );
}

body.dark .hero-text p,
body.dark .hero-card p,
body.dark .section-title p {
    color: #94a3b8;
}

body.dark .hero-card,
body.dark .form,
body.dark .result {
    background: #1e293b;

    border-color: #334155;
}

body.dark .address {
    background: #052e16;
}

body.dark .address p {
    color: #cbd5e1;
}

body.dark .result-item {
    border-color: #334155;
}

body.dark .result-item span {
    color: #94a3b8;
}

body.dark .how {
    background: #0f172a;
}

body.dark .cep-input input {
    background: #0f172a;

    color: white;

    border-color: #475569;
}

body.dark .total {
    background: #052e16;
}

body.dark .maps-button {
    background: #334155;
}


/* =========================
   RESPONSIVO
========================= */

@media (max-width: 850px) {

    nav {
        display: none;
    }

    .hero-content {
        grid-template-columns: 1fr;
    }

    .calculator {
        grid-template-columns: 1fr;
    }

    .steps {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 43px;
    }

}

@media (max-width: 550px) {

    .cep-input {
        flex-direction: column;
    }

    .cep-input button {
        width: 100%;
    }

    .hero h1 {
        font-size: 36px;
    }

    .result-item {
        flex-direction: column;

        gap: 5px;
    }

    .result-item strong {
        text-align: left;
    }

}
